---
import { profiles } from '../data/en';
import Icon from './Icon.astro';
---

<div class="home-profiles" id="profiles">
  <ul
    class="profile-list"
    style={`--profile-rows: ${Math.ceil(profiles.length / 2)}`}
  >
    {profiles.map((profile, index) => (
      <li>
        <a
          class="profile-link"
          href={profile.url}
          target="_blank"
          rel="me noopener"
        >
          <span class="profile-name with-icon">
            <Icon name={profile.icon} brand />
            <span>{profile.name}</span>
          </span>
          <span
            class="profile-description"
            data-i18n={`profiles.${index}.description`}
          >
            {profile.description}
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
