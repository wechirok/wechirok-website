---
import { preferences } from '../data/en';
import Icon from './Icon.astro';
import SectionNavigation from './SectionNavigation.astro';
import Tooltip from './Tooltip.astro';

interface Props {
  showNavigation?: boolean;
}
const { showNavigation = false } = Astro.props;

const languages = [
  { locale: 'en', name: 'English' },
  { locale: 'de', name: 'Deutsch' },
  { locale: 'uk', name: 'Українська' },
  { locale: 'ru', name: 'Русский' },
] as const;
---

<header class="preferences-bar page-shell" hidden={!showNavigation}>
  {showNavigation && <SectionNavigation />}
  <div class="preferences-controls" data-preferences hidden>
    <div
      class="preference-group"
      role="group"
      aria-label={preferences.theme}
      data-i18n-aria-label="preferences.theme"
    >
      <button
        class="preference-button tooltip-trigger"
        type="button"
        data-theme-choice="dark"
        aria-pressed="true"
        aria-label={preferences.dark}
        data-i18n-aria-label="preferences.dark"
      >
        <Icon name="moon" />
        <Tooltip i18n="preferences.dark">{preferences.dark}</Tooltip>
      </button>
      <button
        class="preference-button tooltip-trigger"
        type="button"
        data-theme-choice="light"
        aria-pressed="false"
        aria-label={preferences.light}
        data-i18n-aria-label="preferences.light"
      >
        <Icon name="sun" />
        <Tooltip i18n="preferences.light">{preferences.light}</Tooltip>
      </button>
    </div>
    <div class="language-picker" data-language-picker>
      <button
        class="preference-button tooltip-trigger"
        type="button"
        data-language-toggle
        aria-label={preferences.language}
        data-i18n-aria-label="preferences.language"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="language-menu"
      >
        <Icon name="languages" />
        <Tooltip i18n="preferences.language">{preferences.language}</Tooltip>
      </button>
      <div
        id="language-menu"
        class="language-menu"
        role="menu"
        aria-label={preferences.language}
        data-i18n-aria-label="preferences.language"
        data-language-menu
        hidden
      >
        {languages.map((language) => (
          <button
            type="button"
            role="menuitemradio"
            data-locale={language.locale}
            lang={language.locale}
            aria-checked={language.locale === 'en' ? 'true' : 'false'}
            tabindex="-1"
          >
            <span>{language.name}</span>
            <span class="language-check">
              <Icon name="check" />
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</header>
