---
import {
  sections,
  workAreas,
  projects,
  projectActivity,
  type SectionName,
} from '../data/en';
import Icon from './Icon.astro';
import Toolkit from './Toolkit.astro';
import TranslationContributions from './TranslationContributions.astro';

interface Props {
  name: SectionName;
}

const { name } = Astro.props;
const section = sections[name];
const LeadTag = name === 'about' ? 'p' : 'h2';
---

<div class="section-content">
  <LeadTag class="section-lead" data-i18n={`sections.${name}.lead`}>
    {section.lead}
  </LeadTag>
  <div class="section-prose">
    {section.paragraphs.map((paragraph, index) => (
      <p data-i18n={`sections.${name}.paragraphs.${index}`}>{paragraph}</p>
    ))}
  </div>

  {name === 'work' && (
    <dl class="text-list work-list">
      {workAreas.map((area, index) => (
        <div class="text-row">
          <dt class="with-icon">
            <Icon name={area.icon} />
            <span data-i18n={`workAreas.${index}.title`}>{area.title}</span>
          </dt>
          <dd data-i18n={`workAreas.${index}.description`}>
            {area.description}
          </dd>
        </div>
      ))}
    </dl>
  )}

  {name === 'work' && <Toolkit />}

  {name === 'projects' && (
    <ul class="text-list project-list">
      {projects.map((project, index) => (
        <li class="text-row">
          <div class="row-title">
            <a href={project.url} target="_blank" rel="noopener">
              {project.name}
            </a>
            <span class="row-detail project-meta">
              <span data-i18n={`projects.${index}.category`}>
                {project.category}
              </span>
              <span class="project-period">
                <time datetime={project.startYear}>{project.startYear}</time>
                {' - '}
                <span data-i18n="projectActivity.present">
                  {projectActivity.present}
                </span>
              </span>
            </span>
          </div>
          <p data-i18n={`projects.${index}.description`}>
            {project.description}
          </p>
        </li>
      ))}
    </ul>
  )}

  {name === 'projects' && <TranslationContributions />}
</div>
